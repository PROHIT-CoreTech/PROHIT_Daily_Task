MONGODB_URI=mongodb://localhost:27017/prohit
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# SMTP connection string, e.g. smtp://user:pass@smtp.example.com:587
# Powers both NextAuth magic-link login and workspace invite emails. Leave
# unset in local dev — both flows fall back to logging instead of sending.
EMAIL_SERVER=
EMAIL_FROM=
# Shared secret for the reminder cron (GET /api/cron/reminders). Whatever
# external scheduler hits that route (Vercel Cron, Railway scheduled job,
# cron-job.org) sends this back as `Authorization: Bearer <value>` or
# `?secret=<value>`. Route fails closed (401) if this is unset.
CRON_SECRET=
