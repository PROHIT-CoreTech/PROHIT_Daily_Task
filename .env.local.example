# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/prohit_daily_task

# --- Auth (NextAuth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
NEXTAUTH_URL=http://localhost:3000

# --- Razorpay Subscriptions ---
# From https://dashboard.razorpay.com/app/keys (use Test Mode keys during development)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder
# From the webhook config screen in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=placeholder
# Plan IDs created in the Razorpay dashboard (Subscriptions > Plans) for each paid tier
RAZORPAY_PLAN_PRO=plan_placeholder_pro
RAZORPAY_PLAN_PRO_STUDENT=plan_placeholder_pro_student
RAZORPAY_PLAN_TEAM=plan_placeholder_team
# Separate Razorpay plan for the AI Add-on (₹99/user/month, sold on top of any base plan)
RAZORPAY_PLAN_AI_ADDON=plan_placeholder_ai_addon

# --- AI Add-on / Quick Recap (Anthropic Claude API) ---
# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-placeholder
ANTHROPIC_MODEL=claude-opus-5

# --- Email (reminders + student verification) ---
# Any SMTP provider works (Gmail app password, Resend SMTP, Brevo, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=placeholder@example.com
SMTP_PASS=placeholder
SMTP_FROM="PROHIT Daily Task <no-reply@example.com>"

# --- Cloudflare R2 (attachments) ---
# From the R2 dashboard: Manage R2 API Tokens
R2_ACCOUNT_ID=placeholder
R2_ACCESS_KEY_ID=placeholder
R2_SECRET_ACCESS_KEY=placeholder
R2_BUCKET_NAME=prohit-daily-task-attachments
# Public bucket URL or custom domain fronting the bucket
R2_PUBLIC_URL=https://placeholder.r2.dev

# --- Calendar Bridge (Google Calendar sync) ---
# From https://console.cloud.google.com/apis/credentials — an OAuth 2.0 Client ID
# of type "Web application". See README for the full setup walkthrough.
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google-calendar/callback

# --- Internal ---
# Shared secret the reminder-dispatch cron must present as a Bearer token
REMINDER_DISPATCH_SECRET=replace-with-a-random-secret
